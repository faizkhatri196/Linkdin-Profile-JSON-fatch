# Server Configuration
PORT=3000
NODE_ENV=development

# Rate Limiting (In-memory IP rate limiter)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# In-Memory Cache TTL in seconds (e.g. 3600 = 1 hour, 0 to disable)
CACHE_TTL_SECONDS=3600

# Upstream Request Timeout (milliseconds)
SCRAPER_TIMEOUT_MS=15000

# Optional LinkedIn Session Cookie for authenticated profile extraction (NEVER commit secrets to git)
# LINKEDIN_LI_AT=
# LINKEDIN_JSESSIONID=

# Optional MongoDB URI (If omitted, system gracefully operates 100% in-memory with $0 cost)
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/linkedin_profiles?retryWrites=true&w=majority
